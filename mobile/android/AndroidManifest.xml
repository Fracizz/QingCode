<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qingcode.companion"
    android:versionCode="1"
    android:versionName="0.0.0">
    <!-- versionCode / versionName are replaced from package.json by scripts/build-android.ps1. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requested only when the user taps "扫码添加" to read the desktop pairing QR code. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Online update: hands a downloaded, signature-checked QingCode APK to the system installer after user confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Background alerts: requested only after the user turns them on in terminal settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_qingcode"
        android:label="QingCode"
        android:theme="@style/QingCodeTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- System camera / QR apps open qingcode://pair?... links from the desktop QR code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="qingcode" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- Runs only while a session is busy and the app is in the background; ends when sessions stop. -->
        <service
            android:name=".SessionWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches terminal sessions on a paired computer and alerts when a running program stops." />
        </service>
    </application>
</manifest>
