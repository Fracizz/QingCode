#!/bin/bash
# Minimal Claude Code TUI stand-in for QingCode prewarm acceptance on hosts without Claude.
# Emulates the folder trust dialog (persisted like ~/.claude.json), the composer and /cd.
d=$(cd "$(dirname "$0")" && pwd)
E=$'\e'
rule='────────────────────────────────────────'
printf 'start cwd=%s\n' "$PWD" >> "$d/claude.log"
if ! grep -qxF -- "$PWD" "$d/claude-trusted.txt" 2>/dev/null; then
    printf '%s[2J%s[H' "$E" "$E"
    printf 'Accessing workspace:\r\n\r\n%s\r\n\r\n' "$PWD"
    printf 'Quick safety check: Is this a project you created or one you trust?\r\n\r\n'
    printf '❯ Yes, I trust this folder\r\n  No, exit\r\n\r\nEnter to confirm · Esc to cancel'
    while IFS= read -rsn1 c; do
        if [ -z "$c" ] || [ "$c" = $'\r' ]; then break; fi
        [ "$c" = "$E" ] && exit 1
    done
    printf '%s\n' "$PWD" >> "$d/claude-trusted.txt"
    printf 'trusted %s\n' "$PWD" >> "$d/claude.log"
fi
history=()
buf=
draw() {
    printf '%s[2J%s[H' "$E" "$E"
    for line in "${history[@]}"; do printf '%s\r\n' "$line"; done
    printf '%s\r\n❯ %s\r\n%s' "$rule" "$buf" "$rule"
    [ "$buf" = /cd ] && printf '\r\n  /cd    Move this session to a new working directory'
}
draw
while IFS= read -rsn1 c; do
    if [ -z "$c" ] || [ "$c" = $'\r' ]; then
        cmd=$buf; buf=
        history+=("❯ $cmd")
        case $cmd in
            "/cd "*)
                target=${cmd#/cd }
                if [ "$target" = "$PWD" ]; then
                    history+=("  ⎿  Already in $target.")
                else
                    cd -- "$target" && history+=("  ⎿  Moved to $target")
                fi ;;
            /exit) exit 0 ;;
        esac
        draw
        continue
    fi
    buf=$buf$c
    draw
done
