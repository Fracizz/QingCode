#!/bin/bash
# Minimal Codex TUI stand-in for QingCode prewarm acceptance on hosts without Codex.
# Emulates only what the prewarm adapter reads: idle OSC, composer, /pwd and /cd.
d=$(cd "$(dirname "$0")" && pwd)
printf 'args=[%s] cwd=%s\n' "$*" "$PWD" >> "$d/codex.log"
E=$'\e'; B=$'\a'
show_prompt() { printf '\r\n› Ask Codex to do anything%s]7501;state=idle:app=codex%s' "$E" "$B"; }
printf 'Codex stub'
show_prompt
buf=
while IFS= read -rsn1 c; do
    if [ -z "$c" ] || [ "$c" = $'\r' ]; then
        cmd=$buf; buf=
        printf '\r%s[2K' "$E"
        case $cmd in
            /pwd) printf '• Current working directory: %s' "$PWD" ;;
            "/cd "*) cd -- "${cmd#/cd }" && printf '• Working directory changed to: %s' "$PWD" ;;
            /exit) exit 0 ;;
        esac
        show_prompt
        continue
    fi
    buf=$buf$c
    printf '\r%s[2K› %s' "$E" "$buf"
done
